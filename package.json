{
  "name": "attendance-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "College attendance dashboard: a React + Tailwind home page and a no-build plain-JS tracker that keeps everything in localStorage.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-tracker.mjs",
    "preview": "vite preview",
    "serve": "npx --yes serve -l 4173 dist",
    "serve:tracker": "npx --yes serve -l 4174 .",
    "sync:calendar": "node scripts/sync-calendar.mjs",
    "test": "node --test",
    "samples": "node scripts/write-samples.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
